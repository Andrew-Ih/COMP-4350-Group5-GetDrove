<mxfile host="app.diagrams.net" type="device">
<diagram id="arch" name="Architecture"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2520" pageHeight="1420" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b style='font-size:24px'&gt;GetDrove — System Architecture&lt;/b&gt; &lt;span style='font-size:14px;color:#555'&gt;(decisions made at the end of Sprint 0 · see ADRs)&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="10" width="1500" height="40" as="geometry"/></mxCell><mxCell id="boundary" value="&lt;b&gt;Oracle Cloud Always Free VM&lt;/b&gt; (A1.Flex · 2 OCPU / 12 GB · Ubuntu 24.04 ARM64) · Docker Compose · one private Docker network · only Traefik is exposed (ports 80/443)" style="rounded=1;arcSize=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=10 5;fillColor=#fafafa;strokeColor=#7a7a7a;strokeWidth=2;verticalAlign=bottom;align=left;spacingLeft=14;spacingBottom=8;fontSize=13;fontColor=#444444;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="290" y="70" width="1700" height="1160" as="geometry"/></mxCell><mxCell id="users" value="Riders &amp; drivers" style="shape=umlActor;verticalLabelPosition=middle;labelPosition=right;align=left;spacingLeft=8;html=1;outlineConnect=0;fillColor=#ffffff;strokeColor=#333333;strokeWidth=2;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="110" y="420" width="50" height="90" as="geometry"/></mxCell><mxCell id="browser" value="&lt;b style='font-size:16px'&gt;Web app (browser)&lt;/b&gt;&lt;br&gt;&lt;i&gt;Next.js + TypeScript&lt;/i&gt;&lt;br&gt;MapLibre GL map · TanStack Query&lt;br&gt;STOMP WebSocket client&lt;br&gt;Stripe Elements" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5f5f0;strokeColor=#0e8a7a;strokeWidth=2;fontSize=12;verticalAlign=top;spacingTop=6;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry 