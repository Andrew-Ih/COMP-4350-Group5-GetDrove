e="shape=point;size=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="2145" y="792" width="4" height="4" as="geometry"/></mxCell><mxCell id="le3" value="" style="rounded=1;html=1;jumpStyle=arc;jumpSize=10;labelBackgroundColor=#ffffff;fontSize=11;dashed=1;dashPattern=8 4;endArrow=open;endFill=0;strokeWidth=2;strokeColor=#4d8a3c;fontColor=#4d8a3c;fontSize=10;" edge="1" parent="1" source="la3" target="lb3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="lt3" value="Asynchronous event via Redis Streams (label = event names; colour = publishing or consuming service)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="2165" y="778" width="295" height="30" as="geometry"/></mxCell><mxCell id="la4" value="" style="shape=point;size=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="2065" y="848" width="4" height="4" as="geometry"/></mxCell><mxCell id="lb4" value="" style="shape=point;size=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="2145" y="848" width="4" height="4" as="geometry"/></mxCell><mxCell id="le4" value="" style="rounded=1;html=1;jumpStyle=arc;jumpSize=10;labelBackgroundColor=#ffffff;fontSize=11;dashed=1;dashPattern=2 3;strokeWidth=3;strokeColor=#b04545;fontColor=#b04545;startArrow=block;endArrow=block;startFill=1;endFill=1;" edge="1" parent="1" source="la4" target="lb4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="lt4" value="WebSocket connection (two-way)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="2165" y="834" width="295" height="30" as="geometry"/></mxCell><mxCell id="lgjwt" value="&lt;b&gt;Auth:&lt;/b&gt; Accounts issues JWTs; every service validates them itself using Accounts' JWKS (/.well-known/jwks.json). Traefik only routes." style="text;html=1;align=left;verticalAlign=top;fontSize=12;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="2065" y="878" width="395" height="60" as="geometry"/></mxCell><mxCell id="assume" value="&lt;b&gt;Key decisions&lt;/b&gt; (docs/architecture/adr)&lt;br&gt;• Java 21 + Spring Boot 3 · Gradle · monorepo&lt;br&gt;• Redis Streams + outbox · Traefik · JWT checked per service&lt;br&gt;• OSRM (car + foot) · MapLibre + OpenFreeMap&lt;br&gt;• Live site deploys from develop; releases → DockerHub&lt;br&gt;• Backup host: AWS Free plan (t4g.large)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f9ff;strokeColor=#3b6fb6;dashed=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2050" y="1060" width="420" height="170" as="geometry"/></mxCell></root></mxGraphModel></diagram>
<diagram id="seq" name="Request seat sequence"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1880" pageHeight="1850" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title2" value="&lt;b style='font-size:24px'&gt;Sequence: a rider requests a seat and the driver accepts&lt;/b&gt; &lt;span style='font-size:14px;color:#555'&gt;(auto-accept off; happy path)&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="10" width="1600" height="40" as="geometry"/></mxCell><mxCell id="p_rider" value="&lt;b&gt;Rider&lt;br&gt;(web app)&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=60;fillColor=#d5f5f0;strokeColor=#0e8a7a;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="160" height="1700" as="geometry"/></mxCell><mxCell id="p_trips" value="&lt;b&gt;Trips&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=60;fillColor=#d5e8d4;strokeColor=#4d8a3c;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="240" y="90" width="160" height="1700" as="geometry"/></mxCell><mxCell id="p_rout" value="&lt;b&gt;Routing&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=60;fillColor=#e8dcf2;strokeColor=#7b4fa0;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="440" y="90" width="160" height="1700" as="geometry"/></mxCell><mxCell id="p_acc" value="&lt;b&gt;Accounts&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=60;fillColor=#dae8fc;strokeColor=#3b6fb6;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="640" y="90" width="160" height="1700" as="geometry"/></mxCell><mxCell id="p_str" value="&lt;b&gt;Outbox → Redis&lt;br&gt;Streams&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=60;fillColor=#f2f2f2;strokeColor=#6b6b6b;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="840" y="90" width="160" height="1700" as="geometry"/></mxCell><mxCell id="p_pay" value="&lt;b&gt;Payments&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=60;fillColor=#ffe6cc;strokeColor=#c77700;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1040" y="90" width="160" height="1700" as="geometry"/></mxCell><mxCell id="p_stripe" value="&lt;b&gt;Stripe&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=60;fillColor=#fff4c2;strokeColor=#a68400;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1240" y="90" width="160" height="1700" as="geometry"/></mxCell><mxCell id="p_noti" value="&lt;b&gt;Notifications&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=60;fillColor=#f8d7d7;strokeColor=#b04545;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1440" y="90" width="160" height="1700" as="geometry"/></mxCell><mxCell id="p_driver" value="&lt;b&gt;Driver&lt;br&gt;(web app)&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=60;fillColor=#d5f5f0;strokeColor=#0e8a7a;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1640" y="90" width="160" height="1700" as="geometry"/></mxCell><mxCell id="m0" value="1. POST /api/trips/{id}/requests {pickupPointId} (JWT)" style="rounded=1;html=1;jumpStyle=arc;jumpSize=10;labelBackgroundColor=#ffffff;fontSize=11;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#1f4e79;fontColor=#1f4e79;align=center;verticalAlign=bottom;exitX=0.5;exitY=0.0647;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0647;entryDx=0;entryDy=0;" edge="1" parent="1" source="p_rider" target="p_trips"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="m1" value="2. GET /internal/blocks (rider ↔ driver blocked?)" style="rounded=1;html=1;jumpStyle=arc;jumpSize=10;labelBackgroundColor=#ffffff;fontSize=11;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;fontColor=#333333;align=center;verticalAlign=bottom;exitX=0.5;exitY=0.1012;exitDx=0;exitDy=0;entryX=0.5;entryY=0.1012;entryDx=0;entryDy=0;" edge="1" parent="1" source="p_trips" target="p_acc"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="m2" value="3. POST /internal/detours (accepted pickups + new pickup)" style="rounded=1;html=1;jumpStyle=arc;jumpSize=10;labelBackgroundColor=#ffffff;fontSize=11;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;fontColor=#333333;align=center;verticalAlign=bottom;exitX=0.5;exitY=0.1376;exitDx=0;exitDy=0;entryX=0.5;entryY=0.1376;entryDx=0;entryDy=0;" edge="1" parent="1" source="p_trips" target="p_rout"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="m3" value="4. +3 min, pickup 2nd in order" style="rounded=1;html=1;jumpStyle=arc;jumpSize=10;labelBackgroundColor=#ffffff;fontSize=11;dashed=1;endArrow=open;endFill=0;strokeWidth=1.5;strokeColor=#555555;fontColor=#555555;align=center;verticalAlign=bottom;exitX=0.5;exitY=0.1741;exitDx=0;exitDy=0;entryX=0.5;entryY=0.1741;entryDx=0;entryDy=0;" edge="1" parent="1" source="p_rout" target="p_trips"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="m4" value="5. GET /internal/users/{id}/reputation (for auto-accept)" style="rounded=1;html=1;jumpStyle=arc;jumpSize=10;labelBackgroundColor=#ffffff;fontSize=11;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;fontColor=#333333;align=center;verticalAlign=bottom;exitX=0.5;exitY=0.2106;exitDx=0;exitDy=0;entryX=0.5;entryY=0.2106;entryDx=0;entryDy=0;" edge="1" parent="1" source="p_trips" target="p_acc"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n5" value="6. Eligibility rules pass; auto-accept off → request PENDING.&lt;br&gt;Save request + SeatRequested to outbox in ONE transaction" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4d8a3c;strokeWidth=1.5;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="330.0" y="488" width="430" height="44" as="geometry"/></mxCell><mxCell id="m6" value="7. 201 Created {status: PENDING, detour, cost}" style="rounded=1;html=1;jumpStyle=arc;jumpSize=10;labelBackgroundColor=#ffffff;fontSize=11;dashed=1;endArrow=open;endFill=0;strokeWidth=1.5;strokeColor=#555555;fontColor=#555555;align=center;verticalAlign=bottom;exitX=0.5;exitY=0.2835;exitDx=0;exitDy=0;entryX=0.5;entryY=0.2835;entryDx=0;entryDy=0;" edge="1" parent="1" source="p_trips" target="p_rider"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="m7" value="8. Outbox relay publishes SeatRequested" style="rounded=1;html=1;jumpStyle=arc;jumpSize=10;labelBackgroundColor=#ffffff;fontSize=11;dashed=1;dashPattern=8 4;endArrow=open;endFill=0;strokeWidth=2;strokeColor=#4d8a3c;fontColor=#4d8a3c;fontSize=10;align=center;verticalAlign=bottom;exitX=0.5;exitY=0.32;exitDx=0;exitDy=0;entryX=0.5;entryY=0.32;entryDx=0;entryDy=0;" edge="1" parent="1" source="p_trips" target="p_str"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="m8" value="9. SeatRequested (consumer group)" style="rounded=1;html=1;jumpStyle=arc;jumpSize=10;labelBackgroundColor=#ffffff;fontSize=11;dashed=1;dashPattern=8 4;endArrow=open;endFill=0;strokeWidth=2;strokeColor=#b04545;fontColor=#b04545;fontSize=10;align=center;verticalAlign=bottom;exitX=0.5;exitY=0.3565;exitDx=0;exitDy=0;entryX=0.5;entryY=0.3565;entryDx=0;entryDy=0;" edge="1" parent="1" source="p_str" target="p_noti"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="m9" value="10. Push + email: “New request, adds 3 min”" style="rounded=1;html=1;jumpStyle=arc;jumpSize=10;labelBackgroundColor=#ffffff;fontSize=11;dashed=1;dashPattern=2 3;strokeWidth=3;strokeColor=#b04545;fontColor=#b04545;startArrow=block;endArrow=block;startFill=1;endFill=1;align=center;verticalAlign=bottom;exitX=0.5;exitY=0.3929;exitDx=0;exitDy=0;entryX=0.5;entryY=0.3929;entryDx=0;entryDy=0;" edge="1" parent="1" source="p_noti" target="p_driver"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="m10" value="11. POST /api/requests/{id}/accept (JWT)" style="rounded=1;html=1;jumpStyle=arc;jumpSize=10;labelBackgroundColor=#ffffff;fontSize=11;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#1f4e79;fontColor=#1f4e79;align=center;verticalAlign=bottom;exitX=0.5;exitY=0.4294;exitDx=0;exitDy=0;entryX=0.5;entryY=0.4294;entryDx=0;entryDy=0;" edge="1" parent="1" source="p_driver" target="p_trips"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n11" value="12. Atomic SQL: seats_available − 1 WHERE seats_available &gt; 0&lt;br&gt;→ ACCEPTED; RequestAccepted to outbox (same transaction)" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4d8a3c;strokeWidth=1.5;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="330.0" y="860" width="430" height="44" as="geometry"/></mxCell><mxCell id="m12" value="13. 200 OK (409 “seat just taken” if none left)" style="rounded=1;html=1;jumpStyle=arc;jumpSize=10;labelBackgroundColor=#ffffff;fontSize=11;dashed=1;endArrow=open;endFill=0;strokeWidth=1.5;strokeColor=#555555;fontColor=#555555;align=center;verticalAlign=bottom;exitX=0.5;exitY=0.5024;exitDx=0;exitDy=0;entryX=0.5;entryY=0.5024;entryDx=0;entryDy=0;" edge="1" parent="1" source="p_trips" target="p_driver"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="m13" value="14. Outbox relay publishes RequestAccepted" style="rounded=1;html=1;jumpStyle=arc;jumpSize=10;labelBackgroundColor=#ffffff;fontSize=11;dashed=1;dashPattern=8 4;endArrow=open;endFill=0;strokeWidth=2;strokeColor=#4d8a3c;fontColor=#4d8a3c;fontSize=10;align=center;verticalAlign=bottom;exitX=0.5;exitY=0.5388;exitDx=0;exitDy=0;entryX=0.5;entryY=0.5388;entryDx=0;entryDy=0;" edge="1" parent="1" source="p_trips" target="p_str"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="m14" value="15. RequestAccepted" style="rounded=1;html=1;jumpStyle=arc;jumpSize=10;labelBackgroundColor=#ffffff;fontSize=11;dashed=1;dashPattern=8 4;endArrow=open;endFill=0;strokeWidth=2;strokeColor=#c77700;fontColor=#c77700;fontSize=10;align=center;verticalAlign=bottom;exitX=0.5;exitY=0.5753;exitDx=0;exitDy=0;entryX=0.5;entryY=0.5753;entryDx=0;entryDy=0;" edge="1" parent="1" source="p_str" target="p_pay"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="m15" value="16. Create PaymentIntent (manual capture, idempotency key)" style="rounded=1;html=1;jumpStyle=arc;jumpSize=10;labelBackgroundColor=#ffffff;fontSize=11;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;fontColor=#333333;align=center;verticalAlign=bottom;exitX=0.5;exitY=0.6118;exitDx=0;exitDy=0;entryX=0.5;entryY=0.6118;entryDx=0;entryDy=0;" edge="1" parent="1" source="p_pay" target="p_stripe"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="m16" value="17. requires_capture (funds held)" style="rounded=1;html=1;jumpStyle=arc;jumpSize=10;labelBackgroundColor=#ffffff;fontSize=11;dashed=1;endArrow=open;endFill=0;strokeWidth=1.5;strokeColor=#555555;fontColor=#555555;align=center;verticalAlign=bottom;exitX=0.5;exitY=0.6482;exitDx=0;exitDy=0;entryX=0.5;entryY=0.6482;entryDx=0;entryDy=0;" edge="1" parent="1" source="p_stripe" target="p_pay"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="m17" value="18. PaymentHeld" style="rounded=1;html=1;jumpStyle=arc;jumpSize=10;labelBackgroundColor=#ffffff;fontSize=11;dashed=1;dashPattern=8 4;endArrow=open;endFill=0;strokeWidth=2;strokeColor=#c77700;fontColor=#c77700;fontSize=10;align=center;verticalAlign=bottom;exitX=0.5;exitY=0.6847;exitDx=0;exitDy=0;entryX=0.5;entryY=0.6847;entryDx=0;entryDy=0;" edge="1" parent="1" source="p_pay" target="p_str"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="m18" value="19. RequestAccepted → update stop sequence &amp; ETAs" style="rounded=1;html=1;jumpStyle=arc;jumpSize=10;labelBackgroundColor=#ffffff;fontSize=11;dashed=1;dashPattern=8 4;endArrow=open;endFill=0;strokeWidth=2;strokeColor=#7b4fa0;fontColor=#7b4fa0;fontSize=10;align=center;verticalAlign=bottom;exitX=0.5;exitY=0.7212;exitDx=0;exitDy=0;entryX=0.5;entryY=0.7212;entryDx=0;entryDy=0;" edge="1" parent="1" source="p_str" target="p_rout"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="m19" value="20. RequestAccepted" style="rounded=1;html=1;jumpStyle=arc;jumpSize=10;labelBackgroundColor=#ffffff;fontSize=11;dashed=1;dashPattern=8 4;endArrow=open;endFill=0;strokeWidth=2;strokeColor=#b04545;fontColor=#b04545;fontSize=10;align=center;verticalAlign=bottom;exitX=0.5;exitY=0.7576;exitDx=0;exitDy=0;entryX=0.5;entryY=0.7576;entryDx=0;entryDy=0;" edge="1" parent="1" source="p_str" target="p_noti"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n20" value="21. Schedule reminder at departure − 30 min" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b04545;strokeWidth=1.5;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1530.0" y="1418" width="300" height="30" as="geometry"/></mxCell><mxCell id="m21" value="22. Push + email: “Confirmed, pickup 7:48 at Osborne &amp; River”" style="rounded=1;html=1;jumpStyle=arc;jumpSize=10;labelBackgroundColor=#ffffff;fontSize=11;dashed=1;dashPattern=2 3;strokeWidth=3;strokeColor=#b04545;fontColor=#b04545;startArrow=block;endArrow=block;startFill=1;endFill=1;align=center;verticalAlign=bottom;exitX=0.5;exitY=0.8306;exitDx=0;exitDy=0;entryX=0.5;entryY=0.8306;entryDx=0;entryDy=0;" edge="1" parent="1" source="p_noti" target="p_rider"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n_alt" value="&lt;b&gt;If the hold fails (step 16):&lt;/b&gt; Payments publishes PaymentFailed → Trips sets the request to PAYMENT_FAILED and returns the seat → Notifications tells the rider to update their card." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c77700;strokeWidth=1.5;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="330.0" y="1564" width="560" height="70" as="geometry"/></mxCell><mxCell id="legend2" value="" style="text;" vertex="1" parent="1"><mxGeometry x="1520" y="1664" width="260" height="10" as="geometry"/></mxCell></root></mxGraphModel></diagram>
</mxfile>