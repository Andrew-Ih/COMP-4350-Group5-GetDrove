# Copy to .env and fill in real values. Never commit .env.
# Each service reads variables with its own prefix (see services/<name>/src/<name>/infrastructure/settings.py).

ACCOUNTS_DATABASE_URL=postgresql+asyncpg://accounts:accounts@localhost:5432/getdrove
TRIPS_DATABASE_URL=postgresql+asyncpg://trips:trips@localhost:5432/getdrove
ROUTING_DATABASE_URL=postgresql+asyncpg://routing:routing@localhost:5432/getdrove
PAYMENTS_DATABASE_URL=postgresql+asyncpg://payments:payments@localhost:5432/getdrove
NOTIFICATIONS_DATABASE_URL=postgresql+asyncpg://notifications:notifications@localhost:5432/getdrove

# Where Accounts' outbox relay sends events (Docker Compose sets redis://redis:6379/0).
ACCOUNTS_REDIS_URL=redis://localhost:6379/0

# ---- Routing engine (OSRM, see infra/osrm/README.md). The defaults below already match
# the ports Docker Compose publishes, so only uncomment these if you change those ports.
# Inside Docker Compose, Routing uses http://osrm-car:5000 and http://osrm-foot:5000 instead.
# ROUTING_OSRM_CAR_URL=http://localhost:5050       # driving routes
# ROUTING_OSRM_FOOT_URL=http://localhost:5051      # walking times

# ---- Notifications email (ADR 0010). Defaults suit local development with Docker Compose's
# Mailpit (http://localhost:8025 shows every email). Production uses Brevo's SMTP relay.
# NOTIFICATIONS_REDIS_URL=redis://localhost:6379/0
# NOTIFICATIONS_SMTP_HOST=localhost                # production: smtp-relay.brevo.com
# NOTIFICATIONS_SMTP_PORT=1025                     # production: 587
# NOTIFICATIONS_SMTP_STARTTLS=false                # production: true
# NOTIFICATIONS_SMTP_USERNAME=                     # production: the Brevo SMTP login
# NOTIFICATIONS_SMTP_PASSWORD=                     # production: the Brevo SMTP key (a secret)
# NOTIFICATIONS_EMAIL_FROM=GetDrove <no-reply@getdrove.local>
# Links in emails open this site: the Next.js dev server locally, the live site in production.
# NOTIFICATIONS_WEB_BASE_URL=http://localhost:3000

# ---- Docker Compose (optional: every value has a local default in infra/docker-compose.yml)
# POSTGRES_PASSWORD=postgres
# ACCOUNTS_DB_PASSWORD=accounts
# TRIPS_DB_PASSWORD=trips
# ROUTING_DB_PASSWORD=routing
# PAYMENTS_DB_PASSWORD=payments
# NOTIFICATIONS_DB_PASSWORD=notifications
# POSTGRES_PORT=5432
# REDIS_PORT=6379
# GATEWAY_PORT=80
# TRAEFIK_DASHBOARD_PORT=8080
# MAILPIT_UI_PORT=8025
# MAILPIT_SMTP_PORT=1025
# OSRM_CAR_PORT=5050
# OSRM_FOOT_PORT=5051

# ---- Access tokens (issue #91)
# Accounts' token signing key: a PEM RSA private key (2048+ bits). Required when
# ACCOUNTS_ENVIRONMENT=production; locally a temporary key is generated if it's missing.
# ACCOUNTS_ENVIRONMENT=development
# ACCOUNTS_JWT_PRIVATE_KEY=
# Where other services fetch Accounts' public key (Docker Compose sets the container URL).
# AUTH_JWKS_URL=http://localhost:8001/.well-known/jwks.json
