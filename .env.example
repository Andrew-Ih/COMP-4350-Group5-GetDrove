# Copy to .env and fill in real values. Never commit .env.
# Each service reads variables with its own prefix (see services/<name>/src/<name>/infrastructure/settings.py).

ACCOUNTS_DATABASE_URL=postgresql+asyncpg://accounts:accounts@localhost:5432/getdrove
TRIPS_DATABASE_URL=postgresql+asyncpg://trips:trips@localhost:5432/getdrove
ROUTING_DATABASE_URL=postgresql+asyncpg://routing:routing@localhost:5432/getdrove
PAYMENTS_DATABASE_URL=postgresql+asyncpg://payments:payments@localhost:5432/getdrove
NOTIFICATIONS_DATABASE_URL=postgresql+asyncpg://notifications:notifications@localhost:5432/getdrove

# ---- Docker Compose (optional: every value has a local default in infra/docker-compose.yml)
# POSTGRES_PASSWORD=postgres
# ACCOUNTS_DB_PASSWORD=accounts
# TRIPS_DB_PASSWORD=trips
# ROUTING_DB_PASSWORD=routing
# PAYMENTS_DB_PASSWORD=payments
# NOTIFICATIONS_DB_PASSWORD=notifications
# POSTGRES_PORT=5432
# REDIS_PORT=6379
# GATEWAY_PORT=80
# TRAEFIK_DASHBOARD_PORT=8080
# MAILPIT_UI_PORT=8025
# MAILPIT_SMTP_PORT=1025
