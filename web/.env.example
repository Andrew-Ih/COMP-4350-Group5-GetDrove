# Frontend settings for `npm run dev`. Copy to .env.local (gitignored) to change them.
# Anything starting with NEXT_PUBLIC_ ends up in the browser: never put secrets here.

# "enabled" serves fake API responses from src/shared/mocks, so pages work without the
# backend. Same as running `npm run dev:mock`.
NEXT_PUBLIC_API_MOCKING=disabled

# Where `npm run dev` forwards /api/* (the Docker Compose gateway).
API_PROXY_URL=http://localhost
