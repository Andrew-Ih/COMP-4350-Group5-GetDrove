{
  "openapi": "3.1.0",
  "info": {
    "title": "GetDrove routing service",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthOut"
                }
              }
            }
          }
        }
      }
    },
    "/internal/routes": {
      "post": {
        "tags": [
          "internal"
        ],
        "summary": "Compute and store a trip's driving route",
        "description": "Called by Trips when a trip is posted. Computes the driving route, stores it for matching, and returns its distance and duration. Target: under 3 seconds. Calling it again for the same trip replaces the route.",
        "operationId": "compute_route_internal_routes_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RouteRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RouteResponse"
                }
              }
            }
          },
          "422": {
            "description": "Invalid input; `errors` lists the fields (code `invalid_input`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                },
                "example": {
                  "type": "about:blank",
                  "title": "Unprocessable Content",
                  "status": 422,
                  "detail": "Invalid input",
                  "instance": "/internal/routes",
                  "code": "invalid_input",
                  "requestId": "b1e2c3d4e5f6",
                  "errors": [
                    {
                      "field": "fieldName",
                      "message": "Field required"
                    }
                  ]
                }
              }
            }
          },
          "503": {
            "description": "The routing engine (OSRM) is unavailable or too slow (code `routing_engine_unavailable`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                },
                "example": {
                  "type": "about:blank",
                  "title": "Service Unavailable",
                  "status": 503,
                  "detail": "The routing engine (OSRM) is unavailable or too slow",
                  "instance": "/internal/routes",
                  "code": "routing_engine_unavailable",
                  "requestId": "b1e2c3d4e5f6"
                }
              }
            }
          }
        }
      }
    },
    "/internal/matches": {
      "post": {
        "tags": [
          "internal"
        ],
        "summary": "Find which trips pass near a rider",
        "description": "From the candidate trips, returns those whose route passes within walking distance of the rider along the road network (a rider across a river with no nearby crossing doesn't match), with the best pickup point for each. Trips that don't match are left out; an empty list is a normal result.",
        "operationId": "match_trips_internal_matches_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MatchRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MatchResponse"
                }
              }
            }
          },
          "422": {
            "description": "Invalid input; `errors` lists the fields (code `invalid_input`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                },
                "example": {
                  "type": "about:blank",
                  "title": "Unprocessable Content",
                  "status": 422,
                  "detail": "Invalid input",
                  "instance": "/internal/matches",
                  "code": "invalid_input",
                  "requestId": "b1e2c3d4e5f6",
                  "errors": [
                    {
                      "field": "fieldName",
                      "message": "Field required"
                    }
                  ]
                }
              }
            }
          },
          "503": {
            "description": "The routing engine (OSRM) is unavailable or too slow (code `routing_engine_unavailable`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                },
                "example": {
                  "type": "about:blank",
                  "title": "Service Unavailable",
                  "status": 503,
                  "detail": "The routing engine (OSRM) is unavailable or too slow",
                  "instance": "/internal/matches",
                  "code": "routing_engine_unavailable",
                  "requestId": "b1e2c3d4e5f6"
                }
              }
            }
          }
        }
      }
    },
    "/internal/pickup-points": {
      "post": {
        "tags": [
          "internal"
        ],
        "summary": "Pickup points for a rider on a trip",
        "description": "Called by Trips for the trip detail and when a seat is requested. Returns up to `limit` points on the trip's route, shortest walk first, each on a road a car can stop on and away from both ends of the route. Points in `exclude` (ones the rider rejected) are never returned.",
        "operationId": "pickup_points_internal_pickup_points_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PickupPointsRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PickupPointsResponse"
                }
              }
            }
          },
          "422": {
            "description": "Invalid input; `errors` lists the fields (code `invalid_input`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                },
                "example": {
                  "type": "about:blank",
                  "title": "Unprocessable Content",
                  "status": 422,
                  "detail": "Invalid input",
                  "instance": "/internal/pickup-points",
                  "code": "invalid_input",
                  "requestId": "b1e2c3d4e5f6",
                  "errors": [
                    {
                      "field": "fieldName",
                      "message": "Field required"
                    }
                  ]
                }
              }
            }
          },
          "404": {
            "description": "No route stored for this trip (code `route_not_found`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                },
                "example": {
                  "type": "about:blank",
                  "title": "Not Found",
                  "status": 404,
                  "detail": "No route stored for this trip",
                  "instance": "/internal/pickup-points",
                  "code": "route_not_found",
                  "requestId": "b1e2c3d4e5f6"
                }
              }
            }
          },
          "503": {
            "description": "The routing engine (OSRM) is unavailable or too slow (code `routing_engine_unavailable`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                },
                "example": {
                  "type": "about:blank",
                  "title": "Service Unavailable",
                  "status": 503,
                  "detail": "The routing engine (OSRM) is unavailable or too slow",
                  "instance": "/internal/pickup-points",
                  "code": "routing_engine_unavailable",
                  "requestId": "b1e2c3d4e5f6"
                }
              }
            }
          }
        }
      }
    },
    "/internal/detours": {
      "post": {
        "tags": [
          "internal"
        ],
        "summary": "Extra driving time for a new pickup",
        "description": "Called by Trips when a seat is requested. Puts the new pickup at the best place among the accepted ones (cheapest insertion) and returns the time it adds. Target: under 1 second; when the routing engine is slow it fails fast with 503 rather than returning a wrong number.",
        "operationId": "detour_internal_detours_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DetourRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DetourResponse"
                }
              }
            }
          },
          "422": {
            "description": "Invalid input; `errors` lists the fields (code `invalid_input`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                },
                "example": {
                  "type": "about:blank",
                  "title": "Unprocessable Content",
                  "status": 422,
                  "detail": "Invalid input",
                  "instance": "/internal/detours",
                  "code": "invalid_input",
                  "requestId": "b1e2c3d4e5f6",
                  "errors": [
                    {
                      "field": "fieldName",
                      "message": "Field required"
                    }
                  ]
                }
              }
            }
          },
          "404": {
            "description": "No route stored for this trip (code `route_not_found`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                },
                "example": {
                  "type": "about:blank",
                  "title": "Not Found",
                  "status": 404,
                  "detail": "No route stored for this trip",
                  "instance": "/internal/detours",
                  "code": "route_not_found",
                  "requestId": "b1e2c3d4e5f6"
                }
              }
            }
          },
          "503": {
            "description": "The routing engine (OSRM) is unavailable or too slow (code `routing_engine_unavailable`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                },
                "example": {
                  "type": "about:blank",
                  "title": "Service Unavailable",
                  "status": 503,
                  "detail": "The routing engine (OSRM) is unavailable or too slow",
                  "instance": "/internal/detours",
                  "code": "routing_engine_unavailable",
                  "requestId": "b1e2c3d4e5f6"
                }
              }
            }
          }
        }
      }
    },
    "/trips/{trip_id}/geometry": {
      "get": {
        "tags": [
          "routes"
        ],
        "summary": "A trip's route for the map",
        "description": "The route as a GeoJSON LineString. The trip's driver gets the full route. Anyone else gets it with the driver's end cut off, by the same margin pickup points keep from the ends, so the driver's home is never shown (#135; until then the full route is returned).",
        "operationId": "route_geometry_trips__trip_id__geometry_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "trip_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Trip Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RouteFeature"
                }
              }
            }
          },
          "422": {
            "description": "Invalid input; `errors` lists the fields (code `invalid_input`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                },
                "example": {
                  "type": "about:blank",
                  "title": "Unprocessable Content",
                  "status": 422,
                  "detail": "Invalid input",
                  "instance": "/trips/{trip_id}/geometry",
                  "code": "invalid_input",
                  "requestId": "b1e2c3d4e5f6",
                  "errors": [
                    {
                      "field": "fieldName",
                      "message": "Field required"
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid access token (code `unauthorized`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                },
                "example": {
                  "type": "about:blank",
                  "title": "Unauthorized",
                  "status": 401,
                  "detail": "Missing or invalid access token",
                  "instance": "/trips/{trip_id}/geometry",
                  "code": "unauthorized",
                  "requestId": "b1e2c3d4e5f6"
                }
              }
            }
          },
          "404": {
            "description": "No route for this trip (code `route_not_found`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                },
                "example": {
                  "type": "about:blank",
                  "title": "Not Found",
                  "status": 404,
                  "detail": "No route for this trip",
                  "instance": "/trips/{trip_id}/geometry",
                  "code": "route_not_found",
                  "requestId": "b1e2c3d4e5f6"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "DetourRequest": {
        "properties": {
          "tripId": {
            "type": "string",
            "format": "uuid",
            "title": "Tripid"
          },
          "acceptedPickups": {
            "items": {
              "$ref": "#/components/schemas/Point"
            },
            "type": "array",
            "maxItems": 6,
            "title": "Acceptedpickups",
            "description": "Pickups of the riders already accepted, in pickup order."
          },
          "newPickup": {
            "$ref": "#/components/schemas/Point"
          }
        },
        "type": "object",
        "required": [
          "tripId",
          "acceptedPickups",
          "newPickup"
        ],
        "title": "DetourRequest"
      },
      "DetourResponse": {
        "properties": {
          "addedSeconds": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Addedseconds",
            "description": "Extra driving time for the new pickup, at its best place.",
            "examples": [
              180
            ]
          },
          "position": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Position",
            "description": "Where the new pickup goes in the pickup order (0 = first).",
            "examples": [
              1
            ]
          },
          "totalSeconds": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Totalseconds",
            "description": "Driving time of the whole trip with the new pickup.",
            "examples": [
              1500
            ]
          }
        },
        "type": "object",
        "required": [
          "addedSeconds",
          "position",
          "totalSeconds"
        ],
        "title": "DetourResponse"
      },
      "HealthOut": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status"
          },
          "service": {
            "type": "string",
            "title": "Service"
          }
        },
        "type": "object",
        "required": [
          "status",
          "service"
        ],
        "title": "HealthOut"
      },
      "InvalidFieldOut": {
        "properties": {
          "field": {
            "type": "string",
            "title": "Field"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "field",
          "message"
        ],
        "title": "InvalidFieldOut"
      },
      "LineString": {
        "properties": {
          "type": {
            "type": "string",
            "const": "LineString",
            "title": "Type",
            "default": "LineString"
          },
          "coordinates": {
            "items": {
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array",
              "maxItems": 2,
              "minItems": 2
            },
            "type": "array",
            "title": "Coordinates",
            "description": "[lng, lat] pairs (GeoJSON order)."
          }
        },
        "type": "object",
        "required": [
          "coordinates"
        ],
        "title": "LineString"
      },
      "Match": {
        "properties": {
          "tripId": {
            "type": "string",
            "format": "uuid",
            "title": "Tripid"
          },
          "pickup": {
            "$ref": "#/components/schemas/Pickup",
            "description": "Best point on the route for this rider: where they're picked up going to campus, or dropped off leaving it. Never near either end of the route, so the driver's own end stays private."
          },
          "walkSeconds": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Walkseconds",
            "description": "Walking time from the rider to the pickup."
          },
          "riderDistanceMeters": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Riderdistancemeters",
            "description": "Distance along the route from `pickup` to the trip's end. Going to campus, that's how far the rider rides; leaving campus, they ride the rest: the trip's distance minus this."
          }
        },
        "type": "object",
        "required": [
          "tripId",
          "pickup",
          "walkSeconds",
          "riderDistanceMeters"
        ],
        "title": "Match"
      },
      "MatchRequest": {
        "properties": {
          "rider": {
            "$ref": "#/components/schemas/Point",
            "description": "The rider's location. Used for matching only, never stored."
          },
          "tripIds": {
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "type": "array",
            "maxItems": 500,
            "title": "Tripids",
            "description": "Candidate trips Trips has already filtered by time, seats and status."
          }
        },
        "type": "object",
        "required": [
          "rider",
          "tripIds"
        ],
        "title": "MatchRequest"
      },
      "MatchResponse": {
        "properties": {
          "matches": {
            "items": {
              "$ref": "#/components/schemas/Match"
            },
            "type": "array",
            "title": "Matches",
            "description": "Only trips whose route passes within walking distance."
          }
        },
        "type": "object",
        "required": [
          "matches"
        ],
        "title": "MatchResponse"
      },
      "Pickup": {
        "properties": {
          "label": {
            "type": "string",
            "title": "Label",
            "examples": [
              "Osborne St & River Ave"
            ]
          },
          "lat": {
            "type": "number",
            "title": "Lat"
          },
          "lng": {
            "type": "number",
            "title": "Lng"
          }
        },
        "type": "object",
        "required": [
          "label",
          "lat",
          "lng"
        ],
        "title": "Pickup"
      },
      "PickupPoint": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id",
            "description": "Opaque ID of this point on the stored route. Trips sends it back when the rider requests a seat.",
            "examples": [
              "s42"
            ]
          },
          "label": {
            "type": "string",
            "title": "Label",
            "examples": [
              "Osborne St & River Ave"
            ]
          },
          "lat": {
            "type": "number",
            "title": "Lat"
          },
          "lng": {
            "type": "number",
            "title": "Lng"
          },
          "walkSeconds": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Walkseconds",
            "description": "Walking time from the rider to this point."
          },
          "riderDistanceMeters": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Riderdistancemeters",
            "description": "Distance along the route from this point to the trip's end (as in `Match.riderDistanceMeters`)."
          }
        },
        "type": "object",
        "required": [
          "id",
          "label",
          "lat",
          "lng",
          "walkSeconds",
          "riderDistanceMeters"
        ],
        "title": "PickupPoint"
      },
      "PickupPointsRequest": {
        "properties": {
          "tripId": {
            "type": "string",
            "format": "uuid",
            "title": "Tripid"
          },
          "rider": {
            "$ref": "#/components/schemas/Point",
            "description": "The rider's location. Used for this answer only, never stored."
          },
          "limit": {
            "type": "integer",
            "maximum": 5.0,
            "minimum": 1.0,
            "title": "Limit",
            "description": "How many points to return at most.",
            "default": 3
          },
          "exclude": {
            "items": {
              "type": "string",
              "maxLength": 64,
              "minLength": 1
            },
            "type": "array",
            "maxItems": 20,
            "title": "Exclude",
            "description": "IDs of points the rider rejected (#136). They're never returned, so the next best come back instead. At most 20.",
            "examples": [
              [
                "s42",
                "s45"
              ]
            ]
          }
        },
        "type": "object",
        "required": [
          "tripId",
          "rider"
        ],
        "title": "PickupPointsRequest"
      },
      "PickupPointsResponse": {
        "properties": {
          "pickups": {
            "items": {
              "$ref": "#/components/schemas/PickupPoint"
            },
            "type": "array",
            "title": "Pickups",
            "description": "Best (shortest walk) first. Never on an excluded road and never near either end of the route. Empty if the route doesn't pass within walking distance."
          }
        },
        "type": "object",
        "required": [
          "pickups"
        ],
        "title": "PickupPointsResponse"
      },
      "Point": {
        "properties": {
          "lat": {
            "type": "number",
            "maximum": 90.0,
            "minimum": -90.0,
            "title": "Lat",
            "examples": [
              49.8794
            ]
          },
          "lng": {
            "type": "number",
            "maximum": 180.0,
            "minimum": -180.0,
            "title": "Lng",
            "examples": [
              -97.1663
            ]
          }
        },
        "type": "object",
        "required": [
          "lat",
          "lng"
        ],
        "title": "Point"
      },
      "Problem": {
        "properties": {
          "type": {
            "type": "string",
            "title": "Type",
            "default": "about:blank"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "status": {
            "type": "integer",
            "title": "Status"
          },
          "detail": {
            "type": "string",
            "title": "Detail"
          },
          "instance": {
            "type": "string",
            "title": "Instance"
          },
          "code": {
            "type": "string",
            "title": "Code",
            "description": "Stable error name."
          },
          "requestId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Requestid"
          },
          "errors": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/InvalidFieldOut"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Errors"
          }
        },
        "type": "object",
        "required": [
          "title",
          "status",
          "detail",
          "instance",
          "code"
        ],
        "title": "Problem",
        "description": "Every error response (RFC 9457 Problem Details, `application/problem+json`)."
      },
      "RouteFeature": {
        "properties": {
          "type": {
            "type": "string",
            "const": "Feature",
            "title": "Type",
            "default": "Feature"
          },
          "geometry": {
            "$ref": "#/components/schemas/LineString"
          },
          "properties": {
            "$ref": "#/components/schemas/RouteProperties"
          }
        },
        "type": "object",
        "required": [
          "geometry",
          "properties"
        ],
        "title": "RouteFeature",
        "description": "A GeoJSON Feature (RFC 7946), ready for MapLibre."
      },
      "RouteProperties": {
        "properties": {
          "tripId": {
            "type": "string",
            "format": "uuid",
            "title": "Tripid"
          },
          "distanceMeters": {
            "type": "integer",
            "title": "Distancemeters"
          },
          "durationSeconds": {
            "type": "integer",
            "title": "Durationseconds"
          }
        },
        "type": "object",
        "required": [
          "tripId",
          "distanceMeters",
          "durationSeconds"
        ],
        "title": "RouteProperties"
      },
      "RouteRequest": {
        "properties": {
          "tripId": {
            "type": "string",
            "format": "uuid",
            "title": "Tripid"
          },
          "origin": {
            "$ref": "#/components/schemas/Point"
          },
          "destination": {
            "$ref": "#/components/schemas/Point"
          },
          "driverId": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Driverid",
            "description": "The trip's driver, who sees the full route on the map. Sent from Sprint 2 (#135); null for routes stored before."
          },
          "direction": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "to_campus",
                  "from_campus"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Direction",
            "description": "Which end is the driver's (the origin going to campus, the destination leaving it), so it can be hidden from riders. Null for routes stored before Sprint 2: both ends are then hidden from everyone."
          }
        },
        "type": "object",
        "required": [
          "tripId",
          "origin",
          "destination"
        ],
        "title": "RouteRequest"
      },
      "RouteResponse": {
        "properties": {
          "tripId": {
            "type": "string",
            "format": "uuid",
            "title": "Tripid"
          },
          "distanceMeters": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Distancemeters",
            "examples": [
              9800
            ]
          },
          "durationSeconds": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Durationseconds",
            "examples": [
              1320
            ]
          }
        },
        "type": "object",
        "required": [
          "tripId",
          "distanceMeters",
          "durationSeconds"
        ],
        "title": "RouteResponse"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "description": "Access token from POST /api/accounts/auth/login (`Authorization: Bearer <token>`).",
        "scheme": "bearer"
      }
    }
  },
  "servers": [
    {
      "url": "/api/routing"
    }
  ]
}
