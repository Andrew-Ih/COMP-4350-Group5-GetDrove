{
  "openapi": "3.1.0",
  "info": {
    "title": "GetDrove payments service",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthOut"
                }
              }
            }
          }
        }
      }
    },
    "/internal/quotes": {
      "post": {
        "tags": [
          "internal"
        ],
        "summary": "Price a rider's share",
        "description": "The rider's estimated cost for travelling `distanceMeters` in the car: $0.45 per km, rounded to the nearest 5 cents, with a $2.00 minimum, plus a one-line explanation. The quote shown when requesting is the amount charged unless the trip changes.",
        "operationId": "quote_internal_quotes_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QuoteRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Quote"
                }
              }
            }
          },
          "422": {
            "description": "Invalid input; `errors` lists the fields (code `invalid_input`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                },
                "example": {
                  "type": "about:blank",
                  "title": "Unprocessable Content",
                  "status": 422,
                  "detail": "Invalid input",
                  "instance": "/internal/quotes",
                  "code": "invalid_input",
                  "requestId": "b1e2c3d4e5f6",
                  "errors": [
                    {
                      "field": "fieldName",
                      "message": "Field required"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/internal/customers/{user_id}/card": {
      "get": {
        "tags": [
          "internal"
        ],
        "summary": "Does this rider have a card?",
        "description": "For Trips: a rider needs a saved card before requesting a seat.",
        "operationId": "card_status_internal_customers__user_id__card_get",
        "parameters": [
          {
            "name": "user_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "User Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CardStatus"
                }
              }
            }
          },
          "422": {
            "description": "Invalid input; `errors` lists the fields (code `invalid_input`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                },
                "example": {
                  "type": "about:blank",
                  "title": "Unprocessable Content",
                  "status": 422,
                  "detail": "Invalid input",
                  "instance": "/internal/customers/{user_id}/card",
                  "code": "invalid_input",
                  "requestId": "b1e2c3d4e5f6",
                  "errors": [
                    {
                      "field": "fieldName",
                      "message": "Field required"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/setup-intent": {
      "post": {
        "tags": [
          "cards"
        ],
        "summary": "Start adding a card",
        "description": "Creates a Stripe SetupIntent for the logged-in rider (and their Stripe customer, the first time). The frontend passes `clientSecret` to Stripe Elements.",
        "operationId": "create_setup_intent_setup_intent_post",
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SetupIntent"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid access token (code `unauthorized`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                },
                "example": {
                  "type": "about:blank",
                  "title": "Unauthorized",
                  "status": 401,
                  "detail": "Missing or invalid access token",
                  "instance": "/setup-intent",
                  "code": "unauthorized",
                  "requestId": "b1e2c3d4e5f6"
                }
              }
            }
          },
          "503": {
            "description": "Stripe can't be reached right now (code `payments_unavailable`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                },
                "example": {
                  "type": "about:blank",
                  "title": "Service Unavailable",
                  "status": 503,
                  "detail": "Stripe can't be reached right now",
                  "instance": "/setup-intent",
                  "code": "payments_unavailable",
                  "requestId": "b1e2c3d4e5f6"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/methods": {
      "get": {
        "tags": [
          "cards"
        ],
        "summary": "My saved cards",
        "description": "Brand, last 4 digits and expiry only. An empty list means no card yet. Read from Stripe, not a copy in our database, so a card is listed as soon as `stripe.confirmCardSetup` succeeds: the frontend refetches this right after it and shows a saving state until it returns.",
        "operationId": "payment_methods_methods_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/PaymentMethod"
                  },
                  "type": "array",
                  "title": "Response Payment Methods Methods Get"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid access token (code `unauthorized`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                },
                "example": {
                  "type": "about:blank",
                  "title": "Unauthorized",
                  "status": 401,
                  "detail": "Missing or invalid access token",
                  "instance": "/methods",
                  "code": "unauthorized",
                  "requestId": "b1e2c3d4e5f6"
                }
              }
            }
          },
          "503": {
            "description": "Stripe can't be reached right now (code `payments_unavailable`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                },
                "example": {
                  "type": "about:blank",
                  "title": "Service Unavailable",
                  "status": 503,
                  "detail": "Stripe can't be reached right now",
                  "instance": "/methods",
                  "code": "payments_unavailable",
                  "requestId": "b1e2c3d4e5f6"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "CardStatus": {
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid",
            "title": "Userid"
          },
          "hasCard": {
            "type": "boolean",
            "title": "Hascard"
          }
        },
        "type": "object",
        "required": [
          "userId",
          "hasCard"
        ],
        "title": "CardStatus"
      },
      "HealthOut": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status"
          },
          "service": {
            "type": "string",
            "title": "Service"
          }
        },
        "type": "object",
        "required": [
          "status",
          "service"
        ],
        "title": "HealthOut"
      },
      "InvalidFieldOut": {
        "properties": {
          "field": {
            "type": "string",
            "title": "Field"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "field",
          "message"
        ],
        "title": "InvalidFieldOut"
      },
      "PaymentMethod": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id",
            "description": "Stripe's payment method ID.",
            "examples": [
              "pm_1Nx…"
            ]
          },
          "brand": {
            "type": "string",
            "title": "Brand",
            "examples": [
              "visa"
            ]
          },
          "last4": {
            "type": "string",
            "maxLength": 4,
            "minLength": 4,
            "title": "Last4",
            "examples": [
              "4242"
            ]
          },
          "expMonth": {
            "type": "integer",
            "maximum": 12.0,
            "minimum": 1.0,
            "title": "Expmonth",
            "examples": [
              12
            ]
          },
          "expYear": {
            "type": "integer",
            "title": "Expyear",
            "examples": [
              2030
            ]
          },
          "isDefault": {
            "type": "boolean",
            "title": "Isdefault",
            "description": "The card holds are placed on: the most recently added one. Removing cards and choosing the default aren't part of Sprint 2."
          }
        },
        "type": "object",
        "required": [
          "id",
          "brand",
          "last4",
          "expMonth",
          "expYear",
          "isDefault"
        ],
        "title": "PaymentMethod",
        "description": "A saved card. Only what's needed to recognise it."
      },
      "Problem": {
        "properties": {
          "type": {
            "type": "string",
            "title": "Type",
            "default": "about:blank"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "status": {
            "type": "integer",
            "title": "Status"
          },
          "detail": {
            "type": "string",
            "title": "Detail"
          },
          "instance": {
            "type": "string",
            "title": "Instance"
          },
          "code": {
            "type": "string",
            "title": "Code",
            "description": "Stable error name."
          },
          "requestId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Requestid"
          },
          "errors": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/InvalidFieldOut"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Errors"
          }
        },
        "type": "object",
        "required": [
          "title",
          "status",
          "detail",
          "instance",
          "code"
        ],
        "title": "Problem",
        "description": "Every error response (RFC 9457 Problem Details, `application/problem+json`)."
      },
      "Quote": {
        "properties": {
          "amountCents": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Amountcents",
            "description": "$0.45 per km, rounded to the nearest 5 cents, at least $2.00.",
            "examples": [
              420
            ]
          },
          "currency": {
            "type": "string",
            "const": "CAD",
            "title": "Currency",
            "default": "CAD"
          },
          "explanation": {
            "type": "string",
            "title": "Explanation",
            "description": "One line for the rider.",
            "examples": [
              "9.3 km at $0.45/km"
            ]
          }
        },
        "type": "object",
        "required": [
          "amountCents",
          "explanation"
        ],
        "title": "Quote"
      },
      "QuoteRequest": {
        "properties": {
          "distanceMeters": {
            "type": "integer",
            "maximum": 200000.0,
            "minimum": 0.0,
            "title": "Distancemeters",
            "description": "How far the rider travels in the car.",
            "examples": [
              9300
            ]
          }
        },
        "type": "object",
        "required": [
          "distanceMeters"
        ],
        "title": "QuoteRequest"
      },
      "SetupIntent": {
        "properties": {
          "clientSecret": {
            "type": "string",
            "title": "Clientsecret",
            "description": "Pass to Stripe Elements (`stripe.confirmCardSetup`). Card details go straight to Stripe and never reach our servers.",
            "examples": [
              "seti_1Nx…_secret_…"
            ]
          }
        },
        "type": "object",
        "required": [
          "clientSecret"
        ],
        "title": "SetupIntent"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "description": "Access token from POST /api/accounts/auth/login (`Authorization: Bearer <token>`).",
        "scheme": "bearer"
      }
    }
  },
  "servers": [
    {
      "url": "/api/payments"
    }
  ]
}
